#!/usr/bin/env bash
# clawkit-ops-gateway — OpenSSH forced-command entrypoint
#
# Invoked by sshd when opsro connects via the restricted key.
# MUST be root-owned (0755) and NOT writable by opsro.
#
# Design doc §6.2, PR-M1 §3.3:
#   - Rejects non-empty SSH_ORIGINAL_COMMAND (shell/SFTP/SCP/PTY attempts)
#     → exit non-zero, no stdout.
#   - When SSH_ORIGINAL_COMMAND is empty or unset (normal ssh -T):
#     → exec sudo -n /usr/local/sbin/clawkit-ops-mcp-stdio
#   - Does NOT output a banner or read stdin.

set -euo pipefail

# ── Reject non-empty SSH_ORIGINAL_COMMAND (§3.3) ──
# OpenSSH sets this variable to whatever the client typed after the
# hostname. A normal `ssh -T` has NO remote command — the variable is
# empty or unset. Shell (`bash`), SFTP, SCP, and port forwarding all
# set SSH_ORIGINAL_COMMAND to a non-empty value.
# We reject it: no stdout, exit non-zero, never launch MCP.
if [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
    # stderr only — stdout must stay clean for JSON-RPC
    echo "clawkit-ops-gateway: remote command rejected (forced-command only)" >&2
    exit 1
fi

# ── Exec the fixed launcher via sudo ──
# sudoers must grant: opsro ALL=(root) NOPASSWD: /usr/local/sbin/clawkit-ops-mcp-stdio
exec sudo -n /usr/local/sbin/clawkit-ops-mcp-stdio
